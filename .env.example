# Copy to .env. Demo is explicit, local-only, and never uses provider credentials.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_CONTROL_URL=https://potato-potential.rgbknights.com
# Same Vercel origin in production. Local preview uses port 4000 automatically.
NEXT_PUBLIC_CONTROL_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Migration tooling only; runtime jobs use Supabase's HTTPS API.
DATABASE_URL=
# Local Management API tooling only: project-scoped Migrations read-write, Database read.
# Keep this token out of Vercel runtime variables.
SUPABASE_ACCESS_TOKEN=
AGENT37_API_KEY=
INKBOX_ADMIN_KEY=
DESKTOP_TEMPLATE=boundless-hermes-desktop@4
# 32 random bytes as 64 hex characters. Encrypts transient provisioning credentials.
PROVISIONING_ENCRYPTION_KEY=
OPERATOR_EMAILS=you@example.com
DEFAULT_BUDGET_MICROS=5000000
# Opt-in dedicated SMS provisioning. Requires SMS entitlement on the Inkbox account.
ENABLE_SMS=false
# Vercel adds CONTROL_RUNTIME=workflow for production. Protects daily queue repair.
CONTROL_RUNTIME=workflow
CRON_SECRET=
# Server-only Resend key for invitation emails, also used for Supabase SMTP setup.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=noreply@factory.rgbknights.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_FROM_EMAIL=noreply@factory.rgbknights.com
